# systemd alternative to cron. Copy both files to ~/.config/systemd/user/ then:
#   systemctl --user daemon-reload && systemctl --user enable --now investbot.timer
[Unit]
Description=investbot daily run (paper unless INVESTBOT_MODE_FLAGS=--live)

[Service]
Type=oneshot
WorkingDirectory=%h/investbot
ExecStart=%h/investbot/deploy/run_daily.sh
# Environment=INVESTBOT_MODE_FLAGS=--live
